# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Database URL (Postgresql)
DATABASE_URL="postgresql://username:password@localhost:5432/database"

# Email (SMTP)
EMAIL_BRAND_NAME=Brand
EMAIL_FROM="Display Name <email@domain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# S3 Storage (use 'auto' for R2/MinIO; a real region like us-east-1 for AWS)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3-compatible only (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
