# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database"

# Redis
REDIS_URL=redis://localhost:6379

# S3 Storage
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3-compatible only (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Email (SMTP)
EMAIL_BRAND_NAME=Brand
EMAIL_FROM="Brand <brand@domain.com>"
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where the contact form delivers
CONTACT_EMAIL=contact@domain.com
