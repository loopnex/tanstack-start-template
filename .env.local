# Local development defaults, matching docker-compose.yml

# Better Auth (app: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=uCMGNHxTFMmGlAazfz7FmAdWNhvokWXq # Do not use this in production

# Database (PostgreSQL) [Browse: pnpm db:studio]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Redis
REDIS_URL=redis://localhost:6379

# S3 storage (MinIO console: http://localhost:9001, credentials: minioadmin)
S3_REGION=auto
S3_BUCKET=app
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Email (Mailpit inbox: http://localhost:8025)
EMAIL_BRAND_NAME=Brand
EMAIL_FROM="Brand <brand@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
